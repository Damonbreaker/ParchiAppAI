Authorization: Bearer {{p5c}}
Content-Type: application/json

{ "expectedTotal": 302 }

### 5.10 Accept again with the new total -> 200 ACCEPTED: pickupCode (4 digits), acceptedAt,
###      readyBy = acceptedAt + 25 min, acceptedStore = Gupta Kirana with address + phone 9000000012;
###      Gupta's quote ACCEPTED, Sharma's REJECTED
# @name p5Accept
POST {{base}}/requests/{{p5Id}}/accept/{{guptaQuote}}
Authorization: Bearer {{p5c}}
Content-Type: application/json

{ "expectedTotal": 297 }

