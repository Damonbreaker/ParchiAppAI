Authorization: Bearer {{p5s}}

### 5.15 Sharma tries to mark it ready -> 404 REQUEST_NOT_FOUND
POST {{base}}/store/requests/{{p5Id}}/ready
Authorization: Bearer {{p5s}}

### 5.16 Sharma tries to edit the quote -> 409 REQUEST_CLOSED
PUT {{base}}/store/requests/{{p5Id}}/quote
Authorization: Bearer {{p5s}}
Content-Type: application/json

{
  "packingTimeMins": 10,
  "items": [
    { "requestItemId": {{p5i1}}, "offeredQty": 5, "unit": "KG", "linePrice": 250, "status": "AVAILABLE" },
    { "requestItemId": {{p5i2}}, "offeredQty": 1, "unit": "KG", "linePrice": 25, "status": "AVAILABLE" }
  ]
}

### ---------------- winning store (Gupta) ----------------

### 5.17 Gupta opens it -> outcome WON, status ACCEPTED, customer { name "Anita Singh", phone 9000000001 },
###      acceptedAt, readyBy; no pickupCode field
GET {{base}}/store/requests/{{p5Id}}
Authorization: Bearer {{p5g}}

### 5.18 Gupta's ORDERS list -> this request: outcome WON, customerName, myQuoteTotal 297.00, readyBy
GET {{base}}/store/requests?status=ORDERS
Authorization: Bearer {{p5g}}

### 5.19 Gupta marks it ready -> 200, status READY, readyAt set
POST {{base}}/store/requests/{{p5Id}}/ready
Authorization: Bearer {{p5g}}

### 5.20 Ready again -> 409 INVALID_STATUS
POST {{base}}/store/requests/{{p5Id}}/ready
Authorization: Bearer {{p5g}}

### 5.21 Wrong pickup code -> 400 WRONG_PICKUP_CODE (1 in 10,000 chance 0000 is the real code)
POST {{base}}/store/requests/{{p5Id}}/picked-up
Authorization: Bearer {{p5g}}
Content-Type: application/json

{ "pickupCode": "0000" }

### 5.22 Right code (the one the customer saw in 5.10) -> 200, status PICKED_UP, pickedUpAt set
POST {{base}}/store/requests/{{p5Id}}/picked-up
Authorization: Bearer {{p5g}}
Content-Type: application/json

{ "pickupCode": "{{pickupCode}}" }

### 5.23 Gupta's CLOSED list -> this request with outcome WON (it left ORDERS)
GET {{base}}/store/requests?status=CLOSED
Authorization: Bearer {{p5g}}

### 5.24 Customer view -> status PICKED_UP with acceptedAt, readyAt, pickedUpAt, pickupCode, acceptedStore
GET {{base}}/requests/{{p5Id}}
Authorization: Bearer {{p5c}}

######################################################################
### PHASE 6 (as changed in Phase 7) — one-time parchi scan, nothing stored.
### Uses samples/parchi.jpg (a drawn parchi) and samples/not-an-image.jpg (text renamed .jpg).
### The mock reader picks 1 of 3 sample parchis from a hash of the photo, so the
### returned items don't match what's drawn in parchi.jpg; a real OCR will.
######################################################################

### 6.1 Login as seed customer Anita (9000000001)
# @name p6Customer
POST {{base}}/auth/login
Content-Type: application/json

{ "phone": "9000000001", "password": "test123" }

@p6c = {{p6Customer.response.body.token}}

### 6.2 Scan the parchi -> 200 {items:[{name, quantity, unit, confident}]}, no imageId (~0.8 s mock delay)
POST {{base}}/parchi/scan
Authorization: Bearer {{p6c}}
Content-Type: multipart/form-data; boundary=ParchiBoundary

--ParchiBoundary
Content-Disposition: form-data; name="image"; filename="parchi.jpg"
Content-Type: image/jpeg

< ./samples/parchi.jpg
--ParchiBoundary--

### 6.3 A text file renamed to .jpg -> 400 UNSUPPORTED_IMAGE (magic bytes are checked, not the name/header)
POST {{base}}/parchi/scan
Authorization: Bearer {{p6c}}
Content-Type: multipart/form-data; boundary=ParchiBoundary

--ParchiBoundary
Content-Disposition: form-data; name="image"; filename="not-an-image.jpg"
Content-Type: image/jpeg

< ./samples/not-an-image.jpg
--ParchiBoundary--

### 6.4 No "image" field -> 400 VALIDATION_ERROR, fields.image = "is required"
POST {{base}}/parchi/scan
Authorization: Bearer {{p6c}}
Content-Type: multipart/form-data; boundary=ParchiBoundary

--ParchiBoundary
Content-Disposition: form-data; name="photo"

nothing
--ParchiBoundary--

### 6.5 Send the reviewed list with fromPhoto=true -> 201, source PHOTO (no hasImage field).
###     Items come from this body (the customer's edited list), not from the scan.
POST {{base}}/requests
Authorization: Bearer {{p6c}}
Content-Type: application/json

{
  "mode": "NEAREST",
  "lat": 28.5050,
  "lng": 77.3800,
  "fromPhoto": true,
  "items": [
    { "name": "aata", "quantity": 5, "unit": "KG" },
    { "name": "चीनी", "quantity": 2, "unit": "KG" },
    { "name": "bread", "quantity": 1, "unit": "PCS" }
  ]
}


######################################################################
### PHASE 7 — one-time scan, pickup-code lock, rate limits, pagination.
### Self-contained. Run 7.1 -> 7.21 top to bottom.
### Rate limits live in memory: restarting the backend clears them.
######################################################################

### 7.1 Login as Anita (customer, 9000000001)
# @name p7Customer
POST {{base}}/auth/login
Content-Type: application/json

{ "phone": "9000000001", "password": "test123" }

@p7c = {{p7Customer.response.body.token}}

### 7.2 Scan -> 200 {items:[...]} only: no imageId, nothing saved anywhere
POST {{base}}/parchi/scan
Authorization: Bearer {{p7c}}
Content-Type: multipart/form-data; boundary=ParchiBoundary

--ParchiBoundary
Content-Disposition: form-data; name="image"; filename="parchi.jpg"
Content-Type: image/jpeg

< ./samples/parchi.jpg
--ParchiBoundary--

### 7.3 Send the reviewed list with fromPhoto=true -> 201, "source": "PHOTO"
# @name p7Req
POST {{base}}/requests
Authorization: Bearer {{p7c}}
Content-Type: application/json

{
  "mode": "NEAREST",
  "lat": 28.5050,
  "lng": 77.3800,
  "fromPhoto": true,
  "items": [ { "name": "aata", "quantity": 5, "unit": "KG" } ]
}

