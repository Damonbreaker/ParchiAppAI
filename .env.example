# Copy to .env on the server and fill in. Never commit the real .env.

# Public hostname pointing at the VM's public IP (A record), e.g. parchi.duckdns.org
SITE_DOMAIN=parchi.example.com

# Gemini API key used by the OCR service (keep secret)
GEMINI_API_KEY=

# Database password for the bundled Postgres
DB_PASSWORD=change-me-strong-password

# JWT signing secret: at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-32chars-min

# Optional
# VITE_DEMO=1
# PARCHI_AI_OCR_MODEL=gemini-2.0-flash-lite
# JAVA_OPTS=-Xmx1g
